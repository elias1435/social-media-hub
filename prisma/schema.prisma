// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum SocialPlatform {
  FACEBOOK
  INSTAGRAM
  WHATSAPP
  YOUTUBE
  TIKTOK
  TELEGRAM
}

enum SocialAccountStatus {
  CONNECTED
  DISCONNECTED
  ERROR
}

model Organization {
  id        String             @id @default(cuid())
  name      String
  slug      String             @unique
  status    OrganizationStatus @default(ACTIVE)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  memberships   Membership[]
  roles         Role[]
  socialAccounts SocialAccount[]
  activityLogs  ActivityLog[]
  settings      OrganizationSetting?
  invitations   UserInvitation[]
  notifications Notification[]
  threads       MessengerThread[]
  jobs          AutomationJob[]
  analytics     AnalyticsSnapshot[]
  adActions     AdActionRequest[]
}

model User {
  id            String     @id @default(cuid())
  name          String?
  email         String     @unique
  passwordHash  String?
  status        UserStatus @default(ACTIVE)
  isSystemAdmin Boolean    @default(false)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  memberships Membership[]
  activityLogs ActivityLog[]
  invitationsSent UserInvitation[] @relation("InvitationSender")
  notifications Notification[]
  assignedThreads MessengerThread[]
  threadNotes MessengerNote[]
}

model Membership {
  id             String @id @default(cuid())
  organizationId String
  userId         String
  roleId         String

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, userId])
  @@index([roleId])
}

model Role {
  id             String @id @default(cuid())
  organizationId String
  name           String
  key            String
  description    String?

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships  Membership[]
  permissions  RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, key])
}

model Permission {
  id          String @id @default(cuid())
  key         String @unique
  name        String
  description String?

  roles RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model SocialAccount {
  id                String              @id @default(cuid())
  organizationId    String
  platform          SocialPlatform
  externalAccountId String
  name              String
  status            SocialAccountStatus @default(DISCONNECTED)

  username String?
  avatarUrl String?

  accessTokenCiphertext  String?   @db.Text
  refreshTokenCiphertext String?   @db.Text
  tokenExpiresAt         DateTime?

  metadata Json?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, platform, externalAccountId])
  @@index([organizationId, platform])
}

model ActivityLog {
  id             String  @id @default(cuid())
  organizationId String
  actorUserId     String?

  action     String
  entityType String?
  entityId   String?
  details    Json?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User?        @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([actorUserId])
}
model OrganizationSetting {
  organizationId String @id
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  timezone String @default("Asia/Dhaka")
  notifyInApp Boolean @default(true)
  notifyEmail Boolean @default(false)
  autoAssignInbox Boolean @default(false)
  enableAutomation Boolean @default(false)
  defaultPublishMode String @default("now")
  updatedAt DateTime @updatedAt
}

model UserInvitation {
  id String @id @default(cuid())
  organizationId String
  email String
  name String
  roleId String
  invitedById String
  tokenHash String @unique
  expiresAt DateTime
  acceptedAt DateTime?
  createdAt DateTime @default(now())
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy User @relation("InvitationSender", fields: [invitedById], references: [id], onDelete: Cascade)
  @@index([organizationId, email])
  @@index([expiresAt])
}

model Notification {
  id String @id @default(cuid())
  organizationId String
  userId String
  title String
  description String? @db.Text
  href String?
  readAt DateTime?
  emailedAt DateTime?
  createdAt DateTime @default(now())
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([organizationId, userId, createdAt])
}

model MessengerThread {
  id String @id @default(cuid())
  organizationId String
  socialAccountId String
  conversationId String
  assignedToId String?
  leadStatus String @default("NEW")
  state String @default("OPEN")
  labels Json?
  updatedAt DateTime @updatedAt
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedTo User? @relation(fields: [assignedToId], references: [id], onDelete: SetNull)
  notes MessengerNote[]
  @@unique([organizationId, socialAccountId, conversationId])
  @@index([organizationId, assignedToId])
}

model MessengerNote {
  id String @id @default(cuid())
  threadId String
  authorId String
  text String @db.Text
  createdAt DateTime @default(now())
  thread MessengerThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)
  @@index([threadId, createdAt])
}

model AutomationJob {
  id String @id @default(cuid())
  organizationId String
  kind String
  status String @default("PENDING")
  payload Json
  scheduledAt DateTime
  attempts Int @default(0)
  maxAttempts Int @default(3)
  lockedUntil DateTime?
  lastError String? @db.Text
  completedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  @@index([status, scheduledAt])
  @@index([organizationId, createdAt])
}

model AnalyticsSnapshot {
  id String @id @default(cuid())
  organizationId String
  platform SocialPlatform
  externalId String
  metric String
  value Float
  date DateTime @db.Date
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  @@unique([organizationId, platform, externalId, metric, date])
  @@index([organizationId, date])
}

model AdActionRequest {
  id String @id @default(cuid())
  organizationId String
  actorId String
  adAccountId String
  action String
  payload Json
  status String @default("DRAFT")
  externalId String?
  error String? @db.Text
  createdAt DateTime @default(now())
  executedAt DateTime?
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  @@index([organizationId, createdAt])
}
